/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# tick locks (ローカルのファイルロック・実行時生成物)
data/locks/

# universe fundamentals cache (ローカルJSONフォールバック・実行時生成物。Supabaseが正)
data/universe-fundamentals.json

