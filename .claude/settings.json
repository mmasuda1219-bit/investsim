{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\"",
            "timeout": 60,
            "statusMessage": "前回の現在地を読み込み中"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-stop.sh\"",
            "timeout": 120,
            "asyncRewake": true,
            "rewakeSummary": "進捗の自動記録",
            "statusMessage": "現在地を記録中"
          }
        ]
      }
    ]
  }
}
