# InvestSim 環境変数テンプレート
# このファイルをコピーして .env.local を作り、実際の値を入れる（.env.local はgit管理外）
# Vercelにデプロイする場合は、Vercelの Project Settings > Environment Variables に同じものを設定する

# ── AI（Claude）──────────────────────────────────────────────
# ANTHROPIC_API_KEY があれば全AI（tick分析・仮想取引・学習）がAnthropic API経由で動く（従量課金）。
# 公開サイト(Vercel)ではこれが必須。ローカルには claude バイナリが無いサーバーレスでもAPIなら動く。
# キーはオーナー自身のAnthropicアカウントで購入したAPIクレジットで課金される（Claude Codeサブスクとは別系統）。
# キー未設定の場合のみローカルのclaude CLIにフォールバック（ローカル開発専用）。
# https://console.anthropic.com でクレジット購入＋APIキー発行し、スペンドリミット（月間上限）を設定推奨。
ANTHROPIC_API_KEY=

# ── AIの日次上限（任意・未設定なら既定値）────────────────────────
# /api/report/generate と 手動tick は認証が無く誰でも叩けるため、日次上限で費用を守る。
# 全体上限が実質の «支出上限»、個別上限は1人が全体枠を食い潰さないための補助
# （IPは x-forwarded-for 由来で偽装されうるので、頼るのは全体上限のほう）。
# ⚠ 本番で効かせるには supabase/migrations/0004_ai_usage_counters.sql の実行が必要。
#    未実行だと該当APIは503で止まる（費用のガードなので fail-closed）。
#
# AIレポート（Opus 4.8・1回$0.15前後）。既定 全体50回/日・1人5回/日 ≒ 最悪$7.5/日。
AI_REPORT_DAILY_LIMIT=
AI_REPORT_IP_DAILY_LIMIT=
#
# 手動tick（Haiku×13銘柄）。既定 全体100回/日・1セッション10回/日。
# 自動tick（cron・CRON_SECRETで認証済み）の3回/日とは別枠で、公開側の濫用がcronを止めない。
AI_TICK_DAILY_LIMIT=
AI_TICK_SESSION_DAILY_LIMIT=

# 使用するモデル（任意）。未設定なら claude-sonnet-4-6。
# コスト重視なら claude-haiku-4-5、高性能なら claude-opus-4-8。
AI_MODEL=

# /report（AIレポート生成）専用モデル（任意）。未設定なら claude-opus-4-8。
# tick分析のAI_MODELとは独立。レポートは深い分析が必要なためOpusが既定。
# コストを下げたい場合は claude-sonnet-4-6 等で上書き可。
REPORT_AI_MODEL=

# /report 理論解釈（prepare段）専用モデル（任意）。未設定なら claude-haiku-4-5（安価・高速）。
# 解釈精度を上げたい場合は claude-sonnet-4-6 等で上書き可。tick分析のAI_MODELとは独立。
REPORT_INTERPRET_MODEL=

# ── 運営者（AIを動かせる人）──────────────────────────────
# AIセッションはサイトに1本の公開記録で、読むのは誰でも自由（「見る」はログイン不要）。
# Tick実行・自動運転の切替・セッション作成だけを、ここに書いたユーザーIDに限る。
# 未設定なら誰も動かせない（設定忘れで全員が操作できるより安全側）。カンマ区切りで複数可。
# IDの調べ方: Supabase Dashboard > Authentication > Users の各行のUID。
ADMIN_USER_IDS=

# ── Supabase（認証・DB）──────────────────────────────────────
# https://supabase.com でプロジェクトを作成し、Project Settings > API から取得。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AIセッション永続化（ai_sessionsテーブル）用のservice-roleキー。
# Supabase Dashboard > Project Settings > API の service_role / Secret key（sb_secret_...）。
# ⚠ このキーはRLSをバイパスする秘密キー。絶対に NEXT_PUBLIC_ を付けないこと
# （NEXT_PUBLIC_を付けるとクライアントバンドルに埋め込まれ全世界に漏洩する）。
# 未設定の場合、セッションはローカルファイル data/sessions.json に保存される（ローカル開発用）。
SUPABASE_SERVICE_ROLE_KEY=

# ── 相場データプロバイダ（任意・フォールバック用）─────────────
# メインのYahoo Finance直取得はキー不要。以下は代替プロバイダを使う場合のみ。
# Twelve Data: YahooがVercel IPを429ブロックした際のUS株フェイルオーバー（/report等の実データ必須パスに必要）。
# https://twelvedata.com でメールのみの無料登録でキー取得（無料枠 8リクエスト/分・800/日）。日本株(.T)は無料枠非対応。
TWELVE_DATA_API_KEY=
JQUANTS_API_KEY=

# 使用する相場プロバイダの明示指定（任意）
NEXT_PUBLIC_DATA_PROVIDER=
